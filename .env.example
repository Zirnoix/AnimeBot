# Copier en .env et remplir. Ne jamais committer le .env réel.

# --- Discord (obligatoire) ---
DISCORD_BOT_TOKEN=

# Optionnel : ID application (slash)
APPLICATION_ID=

# Propriétaire du bot (obligatoire) — ID numérique Discord (Paramètres développeur → clic droit profil → Copier l’identifiant)
OWNER_ID=

# Serveurs de dev : sync slash rapide au boot (IDs séparés par virgule)
DEV_GUILD_IDS=

LOG_LEVEL=INFO

BOT_TIMEZONE=Europe/Paris
BOT_VERSION=

ANILIST_USERNAME=
ANILIST_TTL_HOURS=6

DB_PATH=data/bot.db

DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

ASSETS_GUILD_ID=0
OWNER_IDS=
EMOJI_STATE_DIR=data
EMOJI_LOCAL_DIRS=assets/emojis
EMOJI_MANIFEST_URL=
EMOJI_PRUNE=0

NOFILTER=0

# --- Top.gg (votes + XP) : webhook POST vers ton bot public ---
# Sur https://top.gg/bot/<id>/webhooks : URL = https://<ton-domaine>/topgg
# Authorization = exactement la même chaîne que ci-dessous.
# Sur Render / Railway / etc. : PORT est souvent injecté automatiquement (obligatoire pour recevoir le webhook).
TOPGG_WEBHOOK_SECRET=
# Optionnel : lien vote (sinon https://top.gg/bot/<id>/vote)
TOPGG_VOTE_URL=
# Cooldown affiché / rappels (défaut 43200 = 12 h, comme Top.gg)
TOPGG_VOTE_COOLDOWN_SEC=43200
TOPGG_VOTE_XP=45
# Bonus week-end (multiplicateur sur TOPGG_VOTE_XP si isWeekend du webhook)
TOPGG_WEEKEND_XP_MULT=1.5
